# Publish runtime code, required artwork, README illustrations and dependencies.
# Everything else stays local, including docs, tests, tools and match logs.
/*
!/.gitignore
!/main.py
!/README.md
!/README.zh-CN.md
!/requirements*.txt

!/the_kings_gambit/
/the_kings_gambit/*
!/the_kings_gambit/*.py

!/assets/
/assets/*
!/assets/gui/
/assets/gui/*
!/assets/gui/dragon_wager_intro.png

!/assets/readme/
/assets/readme/*
!/assets/readme/cover.png
!/assets/readme/01-menu.png
!/assets/readme/02-opening.png
!/assets/readme/03-select.png
!/assets/readme/04-roll-or-bank.png
!/assets/readme/05-rules.png

__pycache__/
*.py[cod]
